# LAK SAREES — Environment Variables Template
# Copy this file to .env and insert your real credentials when ready for production.
# Never commit your real .env file or private API keys to GitHub.

# Firebase Configuration (Optional for demo mode; mandatory for live production)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=lak-sarees.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lak-sarees-boutique
VITE_FIREBASE_STORAGE_BUCKET=lak-sarees.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Concierge & Contact Settings
VITE_WHATSAPP_NUMBER=919876543210
VITE_CONCIERGE_PHONE=+91 98765 43210
VITE_STORE_CURRENCY=INR
